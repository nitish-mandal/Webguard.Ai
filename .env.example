# Copy to private .env at project root; API and worker load these server settings.
APP_ENV=development
DATABASE_URL=sqlite:///./data/webguard.db
ALLOWED_REPOSITORY=demo-repository
# Local operator token: 32-256 visible ASCII characters. Required for all job routes.
# Empty keeps health/status/readiness available but job routes return 503.
AUTH_TOKEN=
GEMINI_API_KEY=
# Choose a currently available model during implementation; do not hard-code one.
GEMINI_MODEL=
GITHUB_TOKEN=
ENABLE_LIVE_GEMINI=false
ENABLE_GITHUB_DRAFT_PR=false
# Live publication supports a single-repository GitHub App installation token (ghs_).
PUBLICATION_SECONDS=30
PUBLICATION_REQUEST_SECONDS=5
PUBLICATION_MAX_REQUESTS=40
PUBLICATION_RESPONSE_BYTES=1048576
PUBLICATION_REQUEST_BYTES=2097152
MAX_REPAIR_ATTEMPTS=3
MAX_PUBLICATION_ATTEMPTS=3
MAX_LEASE_CLAIMS=5
LEASE_SECONDS=30
WORKER_POLL_SECONDS=1
WORKER_RETRY_SECONDS=10
JOB_TIMEOUT_SECONDS=600
MAX_MODEL_CALLS_PER_JOB=3
MAX_MODEL_TOKENS_PER_JOB=100000
# Integer micro-units of the operator's accounting currency (1 unit = 1,000,000).
MAX_COST_MICROS_PER_JOB=1000000
# Cumulative reserved test execution time per job, not a container implementation.
MAX_EXECUTION_SECONDS=120
MAX_OUTPUT_BYTES=65536
WORKSPACE_ROOT=workspaces
SOURCE_TIMEOUT_SECONDS=20
SOURCE_MAX_FILE_BYTES=1048576
SOURCE_MAX_TOTAL_BYTES=10485760
SOURCE_MAX_FILES=1000
SOURCE_MAX_ARCHIVE_BYTES=10485760
SOURCE_MAX_METADATA_BYTES=1048576
# Prepared LOCAL image ID only; empty blocks execution. No automatic image pull/build.
RUNNER_IMAGE_ID=
RUNNER_CPU_MILLIS=1000
RUNNER_MEMORY_MIB=256
RUNNER_PIDS=64
RUNNER_SCRATCH_MIB=128
RUNNER_TMP_MIB=16
RUNNER_WALL_SECONDS=30
RUNNER_CONTROL_SECONDS=10
MAX_PATCH_FILES=5
MAX_PATCH_LINES=200
REPAIR_INPUT_BYTES=16384
REPAIR_OUTPUT_BYTES=16384
REPAIR_OUTPUT_TOKENS=2048
REPAIR_CALL_SECONDS=20
# HTTP timeout cap; always clamped below the remaining whole-process deadline.
REPAIR_HTTP_TIMEOUT_SECONDS=15
REPAIR_MAX_RETRIES=1
# Conservative operator accounting reservation, not a provider billing quote.
REPAIR_COST_MICROS_PER_CALL=100000
VITE_API_BASE_URL=http://127.0.0.1:8000
